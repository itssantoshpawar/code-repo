{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Order Schema",
  "description": "Schema for order data validation",
  "type": "object",
  "required": ["order_id", "customer_id", "items", "total_amount"],
  "properties": {
    "order_id": {
      "type": "string",
      "description": "Unique order identifier"
    },
    "customer_id": {
      "type": "string",
      "description": "Customer identifier"
    },
    "order_date": {
      "type": "string",
      "description": "Order date in ISO format"
    },
    "items": {
      "type": "array",
      "description": "List of order items",
      "items": {
        "type": "object",
        "properties": {
          "item_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          },
          "price": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": ["item_id", "quantity", "price"]
      }
    },
    "total_amount": {
      "type": "number",
      "description": "Total order amount",
      "minimum": 0
    },
    "currency": {
      "type": "string",
      "description": "Currency code",
      "default": "USD"
    },
    "status": {
      "type": "string",
      "enum": ["pending", "confirmed", "shipped", "delivered", "cancelled"]
    }
  }
}
